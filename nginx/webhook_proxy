server {
    listen 5000 ssl;
    
    server_name YOUR_DOMAIN_HERE;

    ssl_certificate    ssl/certs/selfsigned.crt;
    ssl_certificate_key ssl/certs/selfsigned.key;

    location ~ ^/(5[0-9]+)(/.*)?$ {
        set $backend_port $1;
        set $backend_path $2;

        if ($backend_path = "") {
            set $backend_path "/";
        }

        proxy_pass http://127.0.0.1:$backend_port$backend_path$is_args$args;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Rewrite backend redirects
        proxy_redirect ~^/(.*)$ /$backend_port/$1;
    }
}
